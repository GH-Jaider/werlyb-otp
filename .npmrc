# Seguridad de la cadena de suministro (se versiona en Git para todo el equipo)

# No ejecutar scripts de ciclo de vida (postinstall, preinstall, etc.) al instalar
ignore-scripts=true

# Guardar versiones exactas al instalar (sin '^' ni '~')
save-exact=true

# Auditar vulnerabilidades conocidas al instalar
audit=true
