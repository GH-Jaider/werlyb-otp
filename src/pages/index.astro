---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaEpisodio from '../components/TarjetaEpisodio.astro';
import { SERIE } from '../data/serie';
import { splash, cuadrado } from '../lib/ddragon';
import { partidasDe } from '../lib/partidas';

const episodios = (await getCollection('episodios')).sort(
  (a, b) => b.data.orden - a.data.orden,
);
const ultimo = episodios[0];
const totalVideos = episodios.reduce((n, e) => n + e.data.videos.length, 0);

// El palmarés: cada arco con partidas, ordenado por winrate (desempata el KDA)
const clasificacion = episodios
  .map((e) => ({ e, r: partidasDe(e.id)?.resumen ?? null }))
  .filter((x): x is typeof x & { r: NonNullable<typeof x.r> } => x.r !== null && x.r.partidas > 0)
  .map(({ e, r }) => ({
    id: e.id,
    campeon: e.data.campeon,
    nombre: e.data.nombreCampeon,
    orden: e.data.orden,
    coach: e.data.coach ?? null,
    partidas: r.partidas,
    victorias: r.victorias,
    derrotas: r.derrotas,
    kda: r.kda,
    wr: Math.round((r.victorias / r.partidas) * 100),
  }))
  .sort((a, b) => b.wr - a.wr || b.kda - a.kda);

const totPartidas = clasificacion.reduce((n, c) => n + c.partidas, 0);
const totVictorias = clasificacion.reduce((n, c) => n + c.victorias, 0);
const wrGlobal = totPartidas > 0 ? Math.round((totVictorias / totPartidas) * 100) : null;

const formato = [
  {
    etiqueta: 'El campeón',
    texto:
      'Se acabó rotar el pool de ex-pro: los días que hagan falta encadenando partidas con el mismo campeón, hasta pensar como él.',
  },
  {
    etiqueta: 'El coach',
    texto:
      'Cuando toca, un one-trick de verdad, de los de cientos de miles de puntos de maestría, marca la build, las runas y los matchups.',
  },
  {
    etiqueta: 'El archivo',
    texto:
      'Cada arco queda registrado aquí: sus vídeos día a día, quién vino de coach y, cuando estén contadas, las stats.',
  },
];
---

<Base
  titulo={`${SERIE.titulo} · tracker fan de la serie de Werlyb`}
  ogImage={ultimo ? splash(ultimo.data.campeon) : undefined}
>
  <div class="inicio-pantalla">
    <header class="portada">
      {
        ultimo && (
          <div class="arte fondo">
            <img
              src={splash(ultimo.data.campeon)}
              alt=""
              fetchpriority="high"
              width="1215"
              height="717"
            />
          </div>
        )
      }
      <div class="velo" aria-hidden="true"></div>
      <div class="contenedor portada-contenido">
        <p class="etiqueta sello">Proyecto fan · La serie de Werlyb</p>
        <h1 class="titular grande">
          <span>Siendo</span>
          <span>OTP</span>
          <span>por un día</span>
        </h1>
        <p class="claim">{SERIE.claim}</p>
        <div class="chips">
          {
            ultimo && (
              <a class="chip destacado" href={`/ep/${ultimo.id}/`}>
                Último episodio · {ultimo.data.nombreCampeon} <span aria-hidden="true">→</span>
              </a>
            )
          }
          <a class="chip" href="#episodios">
            {episodios.length} episodios <span aria-hidden="true">↓</span>
          </a>
          {
            clasificacion.length > 0 && (
              <a class="chip" href="#palmares">
                Palmarés <span aria-hidden="true">↓</span>
              </a>
            )
          }
          {
            SERIE.playlist && (
              <a class="chip" href={SERIE.playlist} rel="noopener">
                Playlist en YouTube <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
      </div>
    </header>

    <section class="contenedor formato" aria-label="El formato de la serie">
      {
        formato.map((f) => (
          <div class="pieza">
            <span class="etiqueta roja">{f.etiqueta}</span>
            <p>{f.texto}</p>
          </div>
        ))
      }
    </section>
  </div>

  <main id="contenido">
    <section id="episodios" class="contenedor seccion">
      <div class="cabecera-seccion">
        <h2 class="titular seccion-titulo">El archivo</h2>
        <span class="etiqueta">
          {episodios.length} episodios · {totalVideos} vídeos · se actualiza con la serie
        </span>
      </div>
      <div class="parrilla">
        {episodios.map((e) => <TarjetaEpisodio episodio={e} />)}
      </div>
    </section>

    {
      clasificacion.length > 0 && (
        <section id="palmares" class="contenedor seccion" aria-labelledby="palmares-titulo">
          <div class="cabecera-seccion">
            <h2 id="palmares-titulo" class="titular seccion-titulo">
              El palmarés
            </h2>
            <span class="etiqueta">
              {totPartidas} partidas · {totVictorias}V–{totPartidas - totVictorias}D ·{' '}
              {wrGlobal} % WR global
            </span>
          </div>
          <ol class="ranking">
            {clasificacion.map((c, i) => (
              <li>
                <a class="fila-rank" href={`/ep/${c.id}/`}>
                  <span class="pos titular" data-oro={i === 0 ? 'si' : undefined}>
                    {i + 1}
                  </span>
                  <img
                    class="rk-icono"
                    src={cuadrado(c.campeon)}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                  />
                  <span class="rk-nombre">
                    <b>{c.nombre}</b>
                    <span class="etiqueta rk-meta">
                      EP.{String(c.orden).padStart(2, '0')}
                      {c.coach && <span class="rk-coach"> · con {c.coach}</span>}
                    </span>
                  </span>
                  <span
                    class="rk-barra"
                    role="img"
                    aria-label={`${c.victorias} victorias y ${c.derrotas} derrotas`}
                  >
                    {c.victorias > 0 && <span class="seg v" style={`flex-grow: ${c.victorias}`} />}
                    {c.derrotas > 0 && <span class="seg d" style={`flex-grow: ${c.derrotas}`} />}
                  </span>
                  <span class="rk-cifras">
                    <span class="rk-balance">
                      {c.victorias}V–{c.derrotas}D
                    </span>
                    <b class="rk-wr">{c.wr} %</b>
                    <span class="rk-kda">{c.kda.toFixed(1)} KDA</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <p class="pide-texto">
            ¿Que tu main merece episodio?{' '}
            {
              SERIE.redes.twitch ? (
                <a href={SERIE.redes.twitch} rel="noopener">
                  Suéltalo en el chat de Werlyb
                </a>
              ) : (
                'Suéltalo en el chat de Werlyb'
              )
            }: así salió el arco de Riven, «Lo pedísteis, lo tenéis».
          </p>
        </section>
      )
    }
  </main>
</Base>

<style>
  /* ── Primera pantalla: portada + formato llenan el viewport ── */
  .inicio-pantalla {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  .portada {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .fondo {
    position: absolute;
    inset: 0;
  }

  .velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(10, 10, 12, 0.62) 0%,
        rgba(10, 10, 12, 0.25) 34%,
        rgba(10, 10, 12, 0.55) 62%,
        #0a0a0c 97%
      ),
      linear-gradient(90deg, rgba(10, 10, 12, 0.55) 0%, rgba(10, 10, 12, 0) 55%);
    pointer-events: none;
  }

  .portada-contenido {
    position: relative;
    width: 100%;
    padding-top: clamp(48px, 10vh, 140px);
    padding-bottom: clamp(28px, 5vh, 64px);
  }

  .sello {
    color: var(--gold);
    margin: 0 0 18px;
  }

  .grande {
    font-size: clamp(52px, min(14.5vw, 16vh), 184px);
    color: var(--red);
    text-shadow: 0 0 70px rgba(245, 52, 43, 0.32);
  }

  .grande span {
    display: block;
  }

  .claim {
    margin: 26px 0 0;
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 500;
    color: var(--text);
    max-width: 54ch;
    text-wrap: balance;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .chip {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 18px;
    background: rgba(10, 10, 12, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .chip:hover {
    border-color: var(--muted);
  }

  .chip.destacado {
    color: #0a0a0c;
    background: var(--red);
    border-color: var(--red);
    font-weight: 500;
  }

  .chip.destacado:hover {
    background: var(--red-hot);
    border-color: var(--red-hot);
  }

  /* ── El formato ── */
  .formato {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding-top: clamp(32px, 5vh, 72px);
    padding-bottom: clamp(28px, 5vh, 64px);
  }

  .pieza .roja {
    color: var(--red);
  }

  .pieza p {
    margin: 12px 0 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 38ch;
  }

  /* ── Secciones ── */
  .seccion {
    padding-top: clamp(64px, 9vw, 110px);
  }

  .cabecera-seccion {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
    margin-bottom: 28px;
  }

  .seccion-titulo {
    font-size: clamp(38px, 5.5vw, 64px);
    color: var(--text);
  }

  .parrilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(225px, 1fr));
    gap: 18px;
  }

  /* ── El palmarés ── */
  .ranking {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  .ranking li + li {
    border-top: 1px solid var(--line-soft);
  }

  .fila-rank {
    display: grid;
    grid-template-columns: 44px 40px minmax(150px, 1fr) minmax(120px, 220px) auto;
    gap: 16px;
    align-items: center;
    padding: 11px 18px 11px 10px;
    text-decoration: none;
    background: var(--surface);
    transition: background 0.15s ease;
  }

  .fila-rank:hover {
    background: var(--surface-2);
  }

  /* el overflow:hidden del marco redondeado recortaría el anillo de foco */
  .fila-rank:focus-visible {
    outline-offset: -3px;
    border-radius: 6px;
  }

  .pos {
    font-size: 22px;
    color: var(--faint);
    text-align: center;
  }

  .pos[data-oro='si'] {
    color: var(--gold);
  }

  .rk-icono {
    border-radius: 6px;
    filter: saturate(0.85);
  }

  .rk-nombre {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .rk-nombre b {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }

  .rk-meta {
    font-size: 10.5px;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rk-barra {
    display: flex;
    gap: 2px;
    height: 10px;
  }

  .seg {
    flex-basis: 0;
    border-radius: 3px;
    min-width: 0;
  }

  .seg.v {
    background: var(--win);
  }

  .seg.d {
    background: var(--red);
    opacity: 0.85;
  }

  .rk-cifras {
    display: flex;
    align-items: baseline;
    gap: 16px;
    justify-content: flex-end;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .rk-balance {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .rk-wr {
    font-size: 15px;
    font-weight: 500;
    color: var(--gold);
    min-width: 46px;
    text-align: right;
  }

  .rk-kda {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .pide-texto {
    margin: 26px 0 0;
    font-size: 16px;
    color: var(--muted);
    max-width: 58ch;
  }

  .pide-texto a {
    color: var(--gold);
    text-decoration-color: rgba(200, 170, 110, 0.4);
    text-underline-offset: 3px;
  }

  .pide-texto a:hover {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .inicio-pantalla {
      display: block;
      min-height: 0;
    }
    .portada {
      min-height: 100vh;
      min-height: 100svh;
    }
    .formato {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: clamp(48px, 9vw, 72px);
    }
  }

  @media (max-width: 760px) {
    .fila-rank {
      grid-template-columns: 32px 34px minmax(0, 1fr) auto;
      row-gap: 8px;
    }
    /* la barra V/D pasa a una segunda fila fina a todo el ancho */
    .rk-barra {
      grid-column: 3 / -1;
      grid-row: 2;
      height: 5px;
    }
    .rk-nombre {
      grid-column: 3;
      grid-row: 1;
    }
    .rk-cifras {
      grid-column: 4;
      grid-row: 1;
    }
    .pos {
      font-size: 18px;
    }
    .rk-icono {
      width: 34px;
      height: 34px;
    }
  }

  @media (max-width: 560px) {
    .parrilla {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .rk-kda,
    .rk-coach {
      display: none;
    }
    .rk-cifras {
      gap: 10px;
    }
  }
</style>
