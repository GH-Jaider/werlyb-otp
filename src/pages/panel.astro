---
import '@fontsource/anton';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import paletaJson from '../data/paleta.json';
import { acentoDe, ROJO_MARCA } from '../lib/paleta';

// Los acentos por campeón viajan al navegador ya normalizados, para pintar
// cada episodio con su color como hace la web.
const acentos = Object.fromEntries(
  Object.keys((paletaJson as { acentos: Record<string, string> }).acentos).map((id) => [
    id,
    (acentoDe(id) ?? ROJO_MARCA).hex,
  ]),
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel · Siendo OTP por un día</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/json" id="acentos" set:html={JSON.stringify(acentos)} />
  </head>
  <body>
    <!-- ── Entrar ── -->
    <section id="vista-entrar" class="entrar" hidden>
      <form class="tarjeta-entrar" id="form-entrar">
        <img src="/icon-192.png" alt="" width="72" height="72" />
        <h1 class="titular">Panel</h1>
        <p class="sub">Siendo <span>OTP</span> por un día</p>
        <label class="campo">
          <span class="etiqueta">Contraseña</span>
          <input type="password" id="clave" autocomplete="current-password" required />
        </label>
        <button class="boton" type="submit">Entrar</button>
        <p class="aviso" id="aviso-entrar" role="alert"></p>
      </form>
    </section>

    <!-- ── Trabajo ── -->
    <div id="vista-panel" class="app" hidden>
      <header class="barra">
        <a class="marca titular" href="/" target="_blank">
          <img src="/icon-192.png" alt="" width="28" height="28" />
          Siendo <span>OTP</span> · Panel
        </a>
        <div class="barra-acciones">
          <a class="enlace-sec" href="/" target="_blank">Ver la web ↗</a>
          <button class="enlace-sec" id="btn-salir" type="button">Salir</button>
        </div>
      </header>

      <div class="dos-paneles" data-panel="lista">
        <!-- Izquierda: la lista, siempre a la vista -->
        <aside class="rail" aria-label="Episodios">
          <div class="rail-cabecera">
            <div class="rail-titulo">
              <h2 class="titular">Episodios</h2>
              <button class="boton-sec" id="btn-nuevo" type="button">+ Nuevo</button>
            </div>
            <span class="etiqueta" id="progreso-texto">— / —</span>
            <div class="progreso"><div class="progreso-barra" id="progreso-barra"></div></div>
            <div class="filtros" role="group" aria-label="Filtrar episodios">
              <button class="filtro" data-filtro="todos" type="button" aria-pressed="true">
                Todos <b id="cuenta-todos">0</b>
              </button>
              <button class="filtro" data-filtro="coach" type="button" aria-pressed="false">
                Sin coach <b id="cuenta-coach">0</b>
              </button>
              <button class="filtro" data-filtro="notas" type="button" aria-pressed="false">
                Sin notas <b id="cuenta-notas">0</b>
              </button>
            </div>
          </div>
          <div class="rail-lista" id="lista"></div>
        </aside>

        <!-- Derecha: el episodio -->
        <section class="detalle" id="detalle" aria-label="Episodio">
          <div class="vacio" id="vacio">
            <p>Elige un episodio de la lista para repasarlo.</p>
          </div>

          <div class="editor" id="editor" hidden>
            <div class="ed-scroll">
              <!-- Cabecera del episodio -->
              <div class="ed-cabecera">
                <button class="volver-movil enlace-sec" id="btn-volver" type="button">
                  <span aria-hidden="true">←</span> Episodios
                </button>
                <img class="ed-icono" id="ed-icono" src="" alt="" width="44" height="44" />
                <div class="ed-identidad">
                  <div class="ed-linea">
                    <span class="titular ed-nombre" id="ed-nombre">—</span>
                    <span class="etiqueta ed-num" id="ed-num"></span>
                    <span class="chip-falta" id="ed-falta" hidden></span>
                  </div>
                  <span class="etiqueta ed-meta" id="ed-meta"></span>
                </div>
                <a class="enlace-sec ed-ver" id="ed-ver" href="/" target="_blank">Ver episodio ↗</a>
              </div>

              <!-- Lo que se escribe a mano -->
              <div class="campos">
                <div class="fila-2">
                  <label class="campo">
                    <span class="etiqueta">Coach</span>
                    <input type="text" id="f-coach" placeholder="Quién le enseñó a jugarlo" />
                  </label>
                  <label class="campo">
                    <span class="etiqueta">Canal del coach</span>
                    <input type="url" id="f-canal" placeholder="https://twitch.tv/…" />
                  </label>
                </div>
                <label class="campo">
                  <span class="etiqueta">Rol del coach <span class="chip op">opcional</span></span>
                  <input type="text" id="f-rol" placeholder="OTP de Gwen" />
                </label>
                <label class="campo">
                  <span class="etiqueta">Notas del arco</span>
                  <textarea
                    id="f-notas"
                    rows="5"
                    placeholder="Qué enseñó el coach, los momentos, lo que se aprendió…"></textarea>
                </label>
              </div>

              <!-- Lo que se rellena solo -->
              <div class="autos">
                <button class="auto" id="chip-videos" type="button">
                  <svg viewBox="0 0 24 24" aria-hidden="true"
                    ><rect x="2" y="4" width="20" height="16" rx="3"></rect><path d="M10 9l5 3-5 3z"
                    ></path></svg
                  >
                  <span id="chip-videos-texto">— vídeos</span>
                  <span class="chip auto-tag">entran solos</span>
                </button>
                <div class="auto" id="chip-partidas">
                  <svg viewBox="0 0 24 24" aria-hidden="true"
                    ><path d="M4 19V9M10 19V5M16 19v-6M22 19H2"></path></svg
                  >
                  <span id="chip-partidas-texto">sin partidas</span>
                  <span class="chip auto-tag">las cuenta el robot</span>
                </div>
              </div>

              <!-- Las partidas, para quitar las que no son del reto -->
              <details class="plegable" id="pleg-partidas">
                <summary>
                  <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"
                    ><path d="M9 6l6 6-6 6"></path></svg
                  >
                  <span class="etiqueta">Las partidas, una a una</span>
                  <span class="pista">quita las que no sean del reto</span>
                </summary>
                <div class="pleg-cuerpo">
                  <div id="partidas-lista"></div>
                  <p class="pista" id="partidas-nota"></p>
                </div>
              </details>

              <!-- Los vídeos, plegados: se tocan solo si algo entró mal -->
              <details class="plegable" id="pleg-videos">
                <summary>
                  <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"
                    ><path d="M9 6l6 6-6 6"></path></svg
                  >
                  <span class="etiqueta">Los vídeos, uno a uno</span>
                  <span class="pista">solo si se coló uno o falta alguno</span>
                </summary>
                <div class="pleg-cuerpo">
                  <div id="videos"></div>
                  <button class="boton-sec" id="btn-add-video" type="button">+ Añadir vídeo</button>
                </div>
              </details>

              <!-- Lo que casi nunca se toca -->
              <details class="plegable" id="pleg-ajustes">
                <summary>
                  <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"
                    ><path d="M9 6l6 6-6 6"></path></svg
                  >
                  <span class="etiqueta">Ajustes del arco</span>
                  <span class="pista">número, campeón y fechas de las partidas</span>
                </summary>
                <div class="pleg-cuerpo">
                  <div class="fila-2">
                    <label class="campo">
                      <span class="etiqueta">Nº de episodio</span>
                      <input type="number" id="f-orden" min="1" step="1" required />
                    </label>
                    <label class="campo">
                      <span class="etiqueta">Campeón</span>
                      <input
                        type="text"
                        id="f-buscador"
                        list="lista-campeones"
                        placeholder="Escribe y elige…"
                        autocomplete="off"
                      />
                      <datalist id="lista-campeones"></datalist>
                    </label>
                  </div>
                  <div class="elegido" id="elegido" hidden>
                    <img id="elegido-img" src="" alt="" width="40" height="40" />
                    <div>
                      <b id="elegido-nombre"></b>
                      <span class="etiqueta" id="elegido-titulo"></span>
                    </div>
                  </div>
                  <div class="fila-2">
                    <label class="campo">
                      <span class="etiqueta">Contar desde <span class="chip op">opcional</span></span>
                      <input type="date" id="f-desde" />
                    </label>
                    <label class="campo">
                      <span class="etiqueta">Contar hasta <span class="chip op">opcional</span></span>
                      <input type="date" id="f-hasta" />
                    </label>
                  </div>
                  <p class="pista" id="pista-fechas"></p>
                  <div class="acciones-fechas">
                    <button class="boton-sec" id="btn-fechas-arco" type="button">
                      Usar las fechas del arco
                    </button>
                    <button class="boton-sec" id="btn-fechas-limpiar" type="button">
                      Quitar las fechas
                    </button>
                  </div>
                </div>
              </details>
            </div>

            <!-- Barra de acción fija -->
            <div class="ed-acciones">
              <span class="aviso" id="aviso-editor" role="status">Sin cambios sin publicar</span>
              <div class="ed-botones">
                <button class="boton-sec" id="btn-publicar" type="button">Publicar</button>
                <button class="boton" id="btn-publicar-siguiente" type="button">
                  Publicar y siguiente →
                </button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <script>
      const $ = (id) => document.getElementById(id);
      const ACENTOS = JSON.parse($('acentos').textContent || '{}');
      const ROJO = '#f5342b';

      const api = async (ruta, opciones = {}) => {
        const res = await fetch(`/api/panel/${ruta}`, {
          ...opciones,
          headers: { 'Content-Type': 'application/json', 'X-Panel': '1', ...opciones.headers },
        });
        let datos = {};
        try {
          datos = await res.json();
        } catch {
          /* respuesta sin cuerpo */
        }
        return { ok: res.ok, estado: res.status, datos };
      };

      let episodios = [];
      let actual = null;
      let campeones = [];
      let filtro = 'todos';
      let sucio = false;

      // ── Qué le falta a un episodio ──
      const faltas = (e) => {
        const d = e.datos ?? {};
        const lista = [];
        if (!d.coach) lista.push('coach');
        if (!(e.cuerpo ?? '').trim()) lista.push('notas');
        return lista;
      };

      const acentoDe = (campeon) => ACENTOS[campeon] ?? ROJO;

      // ── Campeones desde Data Dragon (para no tener que saber los IDs) ──
      const cargaCampeones = async () => {
        try {
          const versiones = await (
            await fetch('https://ddragon.leagueoflegends.com/api/versions.json')
          ).json();
          const v = versiones[0];
          const datos = await (
            await fetch(`https://ddragon.leagueoflegends.com/cdn/${v}/data/es_ES/champion.json`)
          ).json();
          campeones = Object.values(datos.data).map((c) => ({
            id: c.id,
            nombre: c.name,
            titulo: c.title,
            icono: `https://ddragon.leagueoflegends.com/cdn/${v}/img/champion/${c.id}.png`,
          }));
          campeones.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
          $('lista-campeones').innerHTML = campeones
            .map((c) => `<option value="${c.nombre}"></option>`)
            .join('');
          if (episodios.length) pintaLista();
        } catch {
          /* sin buscador: se puede escribir el ID a mano */
        }
      };

      const iconoDe = (id) =>
        campeones.find((c) => c.id === id)?.icono ??
        `https://ddragon.leagueoflegends.com/cdn/16.16.1/img/champion/${id}.png`;

      // ── Vistas ──
      const muestra = (cual) => {
        $('vista-entrar').hidden = cual !== 'entrar';
        $('vista-panel').hidden = cual === 'entrar';
      };

      // En móvil los dos paneles se turnan; en escritorio conviven
      const panelMovil = (cual) => {
        document.querySelector('.dos-paneles')?.setAttribute('data-panel', cual);
      };

      const marcaSucio = (valor) => {
        sucio = valor;
        $('aviso-editor').textContent = valor
          ? 'Cambios sin publicar'
          : 'Sin cambios sin publicar';
        $('aviso-editor').dataset.sucio = valor ? 'si' : 'no';
      };

      // ── La lista ──
      const pintaLista = () => {
        const listos = episodios.filter((e) => faltas(e).length === 0).length;
        const sinCoach = episodios.filter((e) => faltas(e).includes('coach')).length;
        const sinNotas = episodios.filter((e) => faltas(e).includes('notas')).length;

        $('progreso-texto').textContent = `${listos} / ${episodios.length} listos`;
        $('progreso-barra').style.width = episodios.length
          ? `${(listos / episodios.length) * 100}%`
          : '0%';
        $('cuenta-todos').textContent = String(episodios.length);
        $('cuenta-coach').textContent = String(sinCoach);
        $('cuenta-notas').textContent = String(sinNotas);

        const visibles = episodios.filter((e) =>
          filtro === 'todos' ? true : faltas(e).includes(filtro),
        );

        $('lista').innerHTML = visibles
          .map((e) => {
            const d = e.datos ?? {};
            const f = faltas(e);
            const num = String(d.orden ?? '?').padStart(2, '0');
            const abajo = d.coach ? d.coach : 'sin coach';
            const marca = f.length === 0
              ? '<svg class="tic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>'
              : `<span class="punto" data-tipo="${f.includes('coach') ? 'coach' : 'notas'}" title="${
                  f.includes('coach') ? 'falta el coach' : 'faltan las notas'
                }"></span>`;
            return `
              <button class="ep" data-slug="${e.slug}" type="button"
                style="--acento: ${acentoDe(d.campeon)}"
                ${actual?.slug === e.slug ? 'data-activo="si"' : ''}>
                <img src="${iconoDe(d.campeon)}" alt="" width="34" height="34" loading="lazy" />
                <span class="ep-texto">
                  <b>${d.nombreCampeon ?? e.slug}</b>
                  <span class="etiqueta">EP.${num} · ${abajo}</span>
                </span>
                ${marca}
              </button>`;
          })
          .join('');

        for (const b of document.querySelectorAll('.ep')) {
          b.addEventListener('click', () => abreEditor(b.dataset.slug));
        }
      };

      // ── Vídeos (filas repetibles) ──
      const filaVideo = (v = {}) => {
        const fila = document.createElement('div');
        fila.className = 'video';
        fila.innerHTML = `
          <input type="text" class="v-titulo" placeholder="Título" value="${(v.titulo ?? '').replace(/"/g, '&quot;')}" />
          <input type="url" class="v-url" placeholder="https://youtube.com/watch?v=…" value="${v.url ?? ''}" />
          <input type="date" class="v-fecha" value="${(v.fecha ?? '').slice(0, 10)}" />
          <button class="quitar" type="button" aria-label="Quitar vídeo">×</button>`;
        fila.querySelector('.quitar').addEventListener('click', () => {
          fila.remove();
          marcaSucio(true);
          pintaPistaFechas();
        });
        return fila;
      };

      const pintaElegido = (id) => {
        const c = campeones.find((x) => x.id === id);
        $('elegido').hidden = !id;
        if (!id) return;
        $('elegido-img').src = iconoDe(id);
        $('elegido-nombre').textContent = c?.nombre ?? id;
        $('elegido-titulo').textContent = c?.titulo ?? id;
      };

      /** Ventana que el robot usaría por su cuenta: la de los vídeos del arco. */
      const ventanaDelArco = () => {
        const fechas = [...document.querySelectorAll('#videos .v-fecha')]
          .map((i) => i.value)
          .filter(Boolean)
          .sort();
        if (!fechas.length) return null;
        const mueve = (f, dias) => {
          const d = new Date(`${f}T00:00:00Z`);
          d.setUTCDate(d.getUTCDate() + dias);
          return d.toISOString().slice(0, 10);
        };
        return { desde: mueve(fechas[0], -7), hasta: mueve(fechas[fechas.length - 1], 4) };
      };

      const pintaPistaFechas = () => {
        const v = ventanaDelArco();
        const manual = $('f-desde').value || $('f-hasta').value;
        $('pista-fechas').textContent = !v
          ? 'Sin vídeos con fecha no se puede sugerir un rango.'
          : manual
            ? `Ahora se cuentan solo las partidas de esas fechas. Si las quitas, el robot usará las del arco: ${v.desde} → ${v.hasta}.`
            : `Vacío: el robot usa las fechas del arco (${v.desde} → ${v.hasta}), que es lo normal.`;
      };

      // ── Partidas del arco: contarlas es cosa del robot, quitarlas es cosa tuya ──
      let partidasArco = []; // [{...ficha, quitada: bool}]

      const fechaLarga = (iso) =>
        new Date(iso)
          .toLocaleString('es-ES', {
            day: 'numeric',
            month: 'short',
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Europe/Madrid',
          })
          .replace(/\./g, '');

      const pintaPartidas = () => {
        const cuentan = partidasArco.filter((p) => !p.quitada);

        if (partidasArco.length === 0) {
          $('partidas-lista').innerHTML =
            '<p class="pista">Todavía no hay partidas contadas para este arco.</p>';
          $('partidas-nota').textContent = '';
        } else {
          $('partidas-lista').innerHTML = partidasArco
            .map((p, i) => {
              const dur = `${Math.floor(p.duracionSeg / 60)}m`;
              return `
                <div class="par" data-i="${i}" data-quitada="${p.quitada ? 'si' : 'no'}" data-gana="${p.victoria ? 'si' : 'no'}">
                  <span class="par-res">${p.victoria ? 'Victoria' : 'Derrota'}</span>
                  <span class="par-cuando">${fechaLarga(p.inicio)} · ${dur} · ${p.cola}</span>
                  <span class="par-kda">${p.kills}/${p.deaths}/${p.assists} · ${p.cs} CS</span>
                  <button class="par-btn" type="button">${p.quitada ? 'Devolver' : 'Quitar'}</button>
                </div>`;
            })
            .join('');

          for (const b of document.querySelectorAll('.par-btn')) {
            b.addEventListener('click', () => {
              const i = Number(b.closest('.par').dataset.i);
              partidasArco[i].quitada = !partidasArco[i].quitada;
              pintaPartidas();
              marcaSucio(true);
            });
          }

          const quitadas = partidasArco.length - cuentan.length;
          $('partidas-nota').textContent = quitadas
            ? `${quitadas} quitada${quitadas === 1 ? '' : 's'}: dejan de contar en la web al publicar.`
            : 'Si alguna no es del reto, quítala y deja de contar en las estadísticas.';
        }

        // El chip de arriba refleja lo que quedaría al publicar
        if (cuentan.length === 0) {
          $('chip-partidas-texto').textContent = 'todavía sin partidas';
          return;
        }
        const v = cuentan.filter((p) => p.victoria).length;
        const k = cuentan.reduce((s, p) => s + p.kills, 0);
        const d = cuentan.reduce((s, p) => s + p.deaths, 0);
        const a = cuentan.reduce((s, p) => s + p.assists, 0);
        const kda = d > 0 ? ((k + a) / d).toFixed(1) : String(k + a);
        const wr = Math.round((v / cuentan.length) * 100);
        $('chip-partidas-texto').textContent =
          `${cuentan.length} partidas · ${v}V–${cuentan.length - v}D · ${wr} % · ${kda} KDA`;
      };

      const cargaResumen = async (slug) => {
        partidasArco = [];
        if (!slug) {
          $('chip-partidas-texto').textContent = 'todavía sin partidas';
          pintaPartidas();
          return;
        }
        $('chip-partidas-texto').textContent = 'contando…';
        const { ok, datos } = await api(`episodios?resumen=${encodeURIComponent(slug)}`);
        if (!ok) {
          $('chip-partidas-texto').textContent = 'todavía sin partidas';
          pintaPartidas();
          return;
        }
        partidasArco = [
          ...(datos.partidas ?? []).map((p) => ({ ...p, quitada: false })),
          ...(datos.excluidas ?? []).map((p) => ({ ...p, quitada: true })),
        ].sort((x, y) => x.inicio.localeCompare(y.inicio));
        pintaPartidas();
      };

      const abreEditor = (slug) => {
        actual = episodios.find((e) => e.slug === slug) ?? null;
        const d = actual?.datos ?? {};
        const acento = acentoDe(d.campeon);

        $('vacio').hidden = true;
        $('editor').hidden = false;
        $('editor').style.setProperty('--acento', acento);

        $('ed-nombre').textContent = d.nombreCampeon ?? 'Episodio nuevo';
        $('ed-num').textContent = d.orden ? `EP.${String(d.orden).padStart(2, '0')}` : 'nuevo';
        $('ed-icono').src = d.campeon ? iconoDe(d.campeon) : '/icon-192.png';
        $('ed-ver').href = actual ? `/ep/${actual.slug}/` : '/';
        $('ed-ver').hidden = !actual;

        const nv = (d.videos ?? []).length;
        $('chip-videos-texto').textContent = `${nv} ${nv === 1 ? 'vídeo' : 'vídeos'}`;
        $('ed-meta').textContent = actual ? `${actual.slug}.md` : 'se creará al publicar';

        const f = actual ? faltas(actual) : [];
        $('ed-falta').hidden = f.length === 0;
        $('ed-falta').textContent =
          f.length === 0 ? '' : f.includes('coach') ? 'Falta el coach' : 'Faltan las notas';

        $('f-orden').value = d.orden ?? (episodios[0]?.datos?.orden ?? 0) + 1;
        $('f-buscador').value = d.nombreCampeon ?? '';
        $('f-coach').value = d.coach ?? '';
        $('f-canal').value = d.canalCoach ?? '';
        $('f-rol').value = d.rolCoach ?? '';
        $('f-desde').value = (d.partidasDesde ?? '').slice(0, 10);
        $('f-hasta').value = (d.partidasHasta ?? '').slice(0, 10);
        $('f-notas').value = actual?.cuerpo ?? '';
        $('videos').innerHTML = '';
        for (const v of d.videos ?? []) $('videos').append(filaVideo(v));

        // Un episodio nuevo abre los ajustes: hay que elegir número y campeón
        $('pleg-ajustes').open = !actual;
        $('pleg-videos').open = false;
        $('pleg-partidas').open = false;

        pintaElegido(d.campeon ?? null);
        pintaPistaFechas();
        marcaSucio(false);
        cargaResumen(actual?.slug ?? null);
        pintaLista();
        panelMovil('detalle');
        $('editor').querySelector('.ed-scroll').scrollTop = 0;
      };

      /** Siguiente episodio con algo pendiente (o el siguiente de la lista). */
      const siguientePendiente = () => {
        if (!actual) return null;
        const i = episodios.findIndex((e) => e.slug === actual.slug);
        const rotados = [...episodios.slice(i + 1), ...episodios.slice(0, i)];
        return (rotados.find((e) => faltas(e).length > 0) ?? rotados[0])?.slug ?? null;
      };

      // ── Publicar ──
      const publica = async ({ siguiente = false } = {}) => {
        const nombre = $('f-buscador').value.trim();
        const c =
          campeones.find((x) => x.nombre.toLowerCase() === nombre.toLowerCase()) ??
          campeones.find((x) => x.id.toLowerCase() === nombre.toLowerCase());

        if (!c && !actual?.datos?.campeon) {
          $('pleg-ajustes').open = true;
          $('aviso-editor').textContent = 'Elige un campeón de la lista.';
          return;
        }

        const campeon = c?.id ?? actual.datos.campeon;
        const orden = Number($('f-orden').value);

        if (!Number.isInteger(orden) || orden < 1) {
          $('pleg-ajustes').open = true;
          $('aviso-editor').textContent = 'El número de episodio no es válido.';
          return;
        }

        const videos = [...document.querySelectorAll('#videos .video')]
          .map((f) => ({
            titulo: f.querySelector('.v-titulo').value.trim(),
            url: f.querySelector('.v-url').value.trim(),
            fecha: f.querySelector('.v-fecha').value || undefined,
          }))
          .filter((v) => v.titulo && v.url);

        const slug = actual?.slug ?? `${String(orden).padStart(2, '0')}-${campeon.toLowerCase()}`;
        const objetivo = siguiente ? siguientePendiente() : null;

        $('btn-publicar').disabled = true;
        $('btn-publicar-siguiente').disabled = true;
        $('aviso-editor').textContent = 'Publicando…';

        const { ok, datos } = await api('episodios', {
          method: 'PUT',
          body: JSON.stringify({
            slug,
            sha: actual?.sha,
            esNuevo: !actual,
            notas: $('f-notas').value,
            datos: {
              orden,
              campeon,
              nombreCampeon: c?.nombre ?? actual?.datos?.nombreCampeon ?? campeon,
              tituloCampeon: c?.titulo ?? actual?.datos?.tituloCampeon ?? '',
              coach: $('f-coach').value,
              canalCoach: $('f-canal').value,
              rolCoach: $('f-rol').value,
              videos,
              partidasDesde: $('f-desde').value,
              partidasHasta: $('f-hasta').value,
              partidasExcluidas: partidasArco.filter((p) => p.quitada).map((p) => p.matchId),
            },
          }),
        });

        $('btn-publicar').disabled = false;
        $('btn-publicar-siguiente').disabled = false;

        if (!ok) {
          $('aviso-editor').textContent = datos.error ?? 'No se pudo publicar.';
          return;
        }

        await carga();

        if (siguiente && objetivo) {
          abreEditor(objetivo);
          $('aviso-editor').textContent = '✓ Publicado';
          return;
        }

        // Se vuelve a abrir con los datos recién guardados
        abreEditor(slug);
        $('aviso-editor').textContent = '✓ Publicado. La web se actualiza en un minuto.';
      };

      // ── Arranque ──
      const carga = async () => {
        const { ok, estado, datos } = await api('episodios');
        if (estado === 401) {
          muestra('entrar');
          return false;
        }
        if (!ok) {
          $('lista').innerHTML = `<p class="pista">${datos.error ?? 'Error al cargar.'}</p>`;
          return true;
        }
        episodios = datos.episodios ?? [];
        pintaLista();
        return true;
      };

      $('form-entrar').addEventListener('submit', async (ev) => {
        ev.preventDefault();
        $('aviso-entrar').textContent = '';
        const { ok, datos } = await api('entrar', {
          method: 'POST',
          body: JSON.stringify({ clave: $('clave').value }),
        });
        if (!ok) {
          $('aviso-entrar').textContent = datos.error ?? 'No se pudo entrar.';
          return;
        }
        $('clave').value = '';
        await carga();
        muestra('panel');
      });

      $('btn-salir').addEventListener('click', async () => {
        await api('salir', { method: 'POST' });
        actual = null;
        muestra('entrar');
      });

      for (const b of document.querySelectorAll('.filtro')) {
        b.addEventListener('click', () => {
          filtro = b.dataset.filtro;
          for (const otro of document.querySelectorAll('.filtro')) {
            otro.setAttribute('aria-pressed', otro === b ? 'true' : 'false');
          }
          pintaLista();
        });
      }

      $('btn-volver').addEventListener('click', () => panelMovil('lista'));
      $('btn-nuevo').addEventListener('click', () => abreEditor(null));
      $('btn-add-video').addEventListener('click', () => {
        $('pleg-videos').open = true;
        $('videos').append(filaVideo());
        marcaSucio(true);
      });
      $('btn-publicar').addEventListener('click', () => publica());
      $('btn-publicar-siguiente').addEventListener('click', () => publica({ siguiente: true }));

      $('f-buscador').addEventListener('change', () => {
        const n = $('f-buscador').value.trim().toLowerCase();
        const c = campeones.find((x) => x.nombre.toLowerCase() === n);
        pintaElegido(c?.id ?? null);
      });

      $('btn-fechas-arco').addEventListener('click', () => {
        const v = ventanaDelArco();
        if (!v) return;
        $('f-desde').value = v.desde;
        $('f-hasta').value = v.hasta;
        pintaPistaFechas();
        marcaSucio(true);
      });

      $('btn-fechas-limpiar').addEventListener('click', () => {
        $('f-desde').value = '';
        $('f-hasta').value = '';
        pintaPistaFechas();
        marcaSucio(true);
      });

      // Cualquier tecleo marca que hay cambios sin publicar
      $('editor').addEventListener('input', (ev) => {
        if (ev.target.closest('.ed-acciones')) return;
        marcaSucio(true);
        if (ev.target.classList.contains('v-fecha')) pintaPistaFechas();
      });

      // Aviso al cerrar con cambios a medias
      window.addEventListener('beforeunload', (ev) => {
        if (!sucio) return;
        ev.preventDefault();
        ev.returnValue = '';
      });

      cargaCampeones();
      carga().then((dentro) => muestra(dentro ? 'panel' : 'entrar'));
    </script>

