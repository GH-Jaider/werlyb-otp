---
import Base from '../layouts/Base.astro';
import { SERIE } from '../data/serie';
---

<Base titulo={`404 — ${SERIE.titulo}`}>
  <main id="contenido" class="contenedor cuatrocero">
    <p class="etiqueta roja">Error 404</p>
    <h1 class="titular grande">Este campeón<br />no está en el pool</h1>
    <a class="volver" href="/">← Volver al archivo</a>
  </main>
</Base>

<style>
  .cuatrocero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
  }

  .roja {
    color: var(--red);
  }

  .grande {
    font-size: clamp(48px, 9vw, 110px);
    color: var(--text);
  }

  .volver {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gold);
    margin-top: 10px;
  }

  .volver:hover {
    color: var(--text);
  }
</style>
