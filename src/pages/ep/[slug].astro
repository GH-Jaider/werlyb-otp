---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PartidaFila from '../../components/PartidaFila.astro';
import { SERIE } from '../../data/serie';
import { loading, splash } from '../../lib/ddragon';
import { partidasDe } from '../../lib/partidas';
import { acentoDe, ROJO_MARCA } from '../../lib/paleta';
import { youtubeId } from '../../lib/video';

export async function getStaticPaths() {
  const episodios = await getCollection('episodios');
  const ordenados = [...episodios].sort((a, b) => a.data.orden - b.data.orden);
  return ordenados.map((episodio, i) => ({
    params: { slug: episodio.id },
    props: {
      episodio,
      anterior: ordenados[i - 1] ?? null,
      siguiente: ordenados[i + 1] ?? null,
    },
  }));
}

const { episodio, anterior, siguiente } = Astro.props;
const d = episodio.data;
const num = String(d.orden).padStart(2, '0');

// Acento del campeón del arco; si no hay ninguno extraído ni override, el
// rojo de marca hace de acento
const acento = acentoDe(d.campeon, d.acento) ?? ROJO_MARCA;

// Cada vecino (anterior/siguiente) lleva SU PROPIO acento, no el de esta
// página: se empaquetan juntos para que solo haya que comprobar un valor
// (si el vecino existe, ya trae su color resuelto)
function vecinoCon(v: typeof anterior) {
  if (!v) return null;
  return { entrada: v, acento: acentoDe(v.data.campeon, v.data.acento) ?? ROJO_MARCA };
}
const vecinoAnterior = vecinoCon(anterior);
const vecinoSiguiente = vecinoCon(siguiente);
const { Content } = await render(episodio);
const hayNotas = Boolean(episodio.body?.trim());

const fechas = d.videos
  .map((v) => v.fecha)
  .filter((f): f is Date => f instanceof Date);

const larga = {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
} as const;
let rango: string | null = null;
if (fechas.length > 0) {
  const a = fechas[0];
  const b = fechas[fechas.length - 1];
  if (a.getTime() === b.getTime()) {
    rango = a.toLocaleDateString('es-ES', larga);
  } else if (a.getUTCMonth() === b.getUTCMonth() && a.getUTCFullYear() === b.getUTCFullYear()) {
    rango = `${a.getUTCDate()} – ${b.toLocaleDateString('es-ES', larga)}`;
  } else {
    rango = `${a.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', timeZone: 'UTC' })} – ${b.toLocaleDateString('es-ES', larga)}`;
  }
}

const fechaCorta = (dt: Date) =>
  dt
    .toLocaleDateString('es-ES', { day: 'numeric', month: 'short', timeZone: 'UTC' })
    .replace(/\./g, '');

// Partidas bajadas de la API de Riot; lo manual del frontmatter manda si existe
const datos = partidasDe(episodio.id);
const resumen = datos && datos.resumen.partidas > 0 ? datos.resumen : null;
const partidasTotales = d.partidas ?? resumen?.partidas ?? null;
const victorias = d.victorias ?? resumen?.victorias ?? null;
const derrotas = d.derrotas ?? resumen?.derrotas ?? null;
const kdaArco = d.kda ?? resumen?.kda ?? null;

const balance = victorias != null && derrotas != null ? `${victorias}V–${derrotas}D` : null;
const hayStats = partidasTotales != null || balance !== null || kdaArco != null;

const winrate =
  resumen && resumen.partidas > 0 ? Math.round((resumen.victorias / resumen.partidas) * 100) : null;
const cuentasUsadas = datos ? [...new Set(datos.partidas.map((p) => p.cuenta))] : [];
const actualizado = datos
  ? new Date(datos.actualizado)
      .toLocaleDateString('es-ES', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'Europe/Madrid',
      })
      .replace(/\./g, '')
  : null;

const videos = d.videos.map((v, i) => ({
  ...v,
  n: i + 1,
  ytId: youtubeId(v.url),
}));
---

<Base
  titulo={`EP.${num} · ${d.nombreCampeon} · ${SERIE.titulo}`}
  descripcion={`Episodio ${num} de ${SERIE.titulo}: Werlyb se hace OTP de ${d.nombreCampeon}${d.coach ? ` con ${d.coach} de coach` : ''} (${d.videos.length} ${d.videos.length === 1 ? 'vídeo' : 'vídeos'} del arco).`}
  ogImage={splash(d.campeon)}
>
  <nav class="contenedor migas" aria-label="Volver">
    <a class="volver" href="/#episodios"><span aria-hidden="true">←</span> Todos los episodios</a>
    <a class="marca-mini titular" href="/">Siendo <span>OTP</span> por un día</a>
  </nav>

  <header class="cabecera-ep">
    <div class="arte fondo">
      <img
        src={splash(d.campeon)}
        alt={`Splash art de ${d.nombreCampeon}`}
        fetchpriority="high"
        width="1215"
        height="717"
      />
    </div>
    <div class="velo" aria-hidden="true"></div>
    <div class="contenedor titulo-ep">
      <p class="etiqueta linea-ep">
        <span class="num">Episodio {num}</span>
        {rango && <span class="fechas-ep"><span class="sep">·</span> {rango}</span>}
      </p>
      <h1 class="titular nombre">{d.nombreCampeon}</h1>
      {d.tituloCampeon && <p class="apodo">{d.tituloCampeon}</p>}
      <p class="coach-linea">
        {
          d.coach ? (
            <>
              con{' '}
              {d.canalCoach ? (
                <a href={d.canalCoach} rel="noopener">
                  {d.coach} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <b>{d.coach}</b>
              )}{' '}
              de coach{d.rolCoach && <span class="coach-rol"> · {d.rolCoach}</span>}
            </>
          ) : (
            <span class="sin-coach">coach por confirmar</span>
          )
        }
      </p>
    </div>
  </header>

  <main id="contenido" class="contenedor cuerpo">
    <div class="principal">
      {
        hayStats && (
          <section class="marcador" aria-label="Stats del arco">
            {
              partidasTotales != null && (
                <div class="stat">
                  <b>{partidasTotales}</b>
                  <span class="stat-eti">partidas</span>
                </div>
              )
            }
            {
              balance && (
                <div class="stat">
                  <b>{balance}</b>
                  <span class="stat-eti">balance</span>
                </div>
              )
            }
            {
              winrate != null && (
                <div class="stat">
                  <b>{winrate} %</b>
                  <span class="stat-eti">winrate</span>
                </div>
              )
            }
            {
              kdaArco != null && (
                <div class="stat">
                  <b>{kdaArco.toFixed(1)}</b>
                  <span class="stat-eti">KDA</span>
                </div>
              )
            }
          </section>
        )
      }

      {
        videos.length > 0 && (
          <section class="videos" aria-label="Vídeos del arco">
            <h2 class="etiqueta lista-titulo">
              El arco · {videos.length} {videos.length === 1 ? 'vídeo' : 'vídeos'}
            </h2>
            <div
              class="videos-parrilla"
              data-solo={videos.length === 1 ? 'si' : undefined}
              data-n={String(videos.length)}
            >
              {videos.map((v) => (
                <a class="video-carta" href={v.url} rel="noopener">
                  <div class="arte v-thumb">
                    {v.ytId ? (
                      <img
                        src={`https://i.ytimg.com/vi/${v.ytId}/hqdefault.jpg`}
                        alt=""
                        loading={v.n <= 2 ? 'eager' : 'lazy'}
                        width="480"
                        height="360"
                      />
                    ) : (
                      <span class="v-hueco" />
                    )}
                    <span class="v-play" aria-hidden="true">
                      ▶
                    </span>
                  </div>
                  <div class="v-pie">
                    <span class="v-num">{String(v.n).padStart(2, '0')}</span>
                    <p class="v-titulo">{v.titulo}</p>
                    {v.fecha && <span class="v-fecha">{fechaCorta(v.fecha)}</span>}
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        resumen && datos && (
          <section class="partidas" aria-label="Partidas del arco">
            <div class="partidas-cabecera">
              <h2 class="etiqueta lista-titulo">
                Las partidas · {resumen.partidas}
              </h2>
              <span class="partidas-resumen">
                {resumen.victorias}V–{resumen.derrotas}D
                {winrate != null && ` · ${winrate} % WR`} · {resumen.kda} KDA
              </span>
            </div>
            <ol class="partidas-lista">
              {datos.partidas.map((p) => (
                <PartidaFila partida={p} />
              ))}
            </ol>
            <p class="partidas-fuente">
              Datos de la API oficial de Riot · {cuentasUsadas.length === 1 ? 'cuenta' : 'cuentas'}{' '}
              {cuentasUsadas.join(' · ')} · actualizado {actualizado}
            </p>
          </section>
        )
      }

      {
        hayNotas ? (
          <article class="notas">
            <h2 class="etiqueta">Notas del arco</h2>
            <div class="prosa">
              <Content />
            </div>
          </article>
        ) : (
          <div class="pendiente-caja">
            <p>
              {d.videos.length > 0
                ? 'Las notas de este arco están por documentar: la build, los momentos clave y el balance.'
                : 'Los vídeos y las notas de este arco están por documentar. La serie va por delante de este archivo.'}
            </p>
          </div>
        )
      }

      {
        ((d.build && d.build.length > 0) || (d.runas && d.runas.length > 0)) && (
          <section class="build-coach" aria-label="Build del coach">
            {
              d.build && d.build.length > 0 && (
                <div>
                  <h2 class="etiqueta">Build del coach</h2>
                  <ol class="lista">
                    {d.build.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ol>
                </div>
              )
            }
            {
              d.runas && d.runas.length > 0 && (
                <div>
                  <h2 class="etiqueta">Runas</h2>
                  <ul class="lista">
                    {d.runas.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )
            }
          </section>
        )
      }
    </div>
  </main>

  <nav class="contenedor vecinos" aria-label="Más episodios">
    {
      vecinoAnterior ? (
        <a
          class="vecino"
          href={`/ep/${vecinoAnterior.entrada.id}/`}
          style={`--acento-vecino: ${vecinoAnterior.acento.hex}; --acento-vecino-rgb: ${vecinoAnterior.acento.rgb};`}
        >
          <div class="arte v-fondo">
            <img
              src={loading(vecinoAnterior.entrada.data.campeon)}
              alt=""
              loading="lazy"
              width="308"
              height="560"
            />
          </div>
          <div class="v-velo" aria-hidden="true" />
          <div class="v-texto">
            <span class="etiqueta v-eti">
              <span aria-hidden="true">←</span> EP.{String(vecinoAnterior.entrada.data.orden).padStart(2, '0')} · anterior
            </span>
            <span class="vecino-nombre titular">{vecinoAnterior.entrada.data.nombreCampeon}</span>
          </div>
        </a>
      ) : (
        <span />
      )
    }
    {
      vecinoSiguiente && (
        <a
          class="vecino derecha"
          href={`/ep/${vecinoSiguiente.entrada.id}/`}
          style={`--acento-vecino: ${vecinoSiguiente.acento.hex}; --acento-vecino-rgb: ${vecinoSiguiente.acento.rgb};`}
        >
          <div class="arte v-fondo">
            <img
              src={loading(vecinoSiguiente.entrada.data.campeon)}
              alt=""
              loading="lazy"
              width="308"
              height="560"
            />
          </div>
          <div class="v-velo" aria-hidden="true" />
          <div class="v-texto">
            <span class="etiqueta v-eti">
              EP.{String(vecinoSiguiente.entrada.data.orden).padStart(2, '0')} · siguiente <span aria-hidden="true">→</span>
            </span>
            <span class="vecino-nombre titular">{vecinoSiguiente.entrada.data.nombreCampeon}</span>
          </div>
        </a>
      )
    }
  </nav>
</Base>

<style define:vars={{ acento: acento.hex, 'acento-rgb': acento.rgb }}>
  .migas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 22px;
    padding-bottom: 22px;
    position: relative;
    z-index: 2;
  }

  .volver {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .volver:hover {
    color: var(--text);
  }

  .marca-mini {
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .marca-mini span {
    color: var(--red);
  }

  /* ── Cabecera del episodio ── */
  .cabecera-ep {
    position: relative;
    margin-top: -66px;
    min-height: clamp(380px, 52vh, 560px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .fondo {
    position: absolute;
    inset: 0;
  }

  .fondo img {
    object-position: center 22%;
  }

  .velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(10, 10, 12, 0.85) 0%,
        rgba(10, 10, 12, 0.15) 38%,
        rgba(10, 10, 12, 0.6) 70%,
        #0a0a0c 98%
      ),
      linear-gradient(90deg, rgba(10, 10, 12, 0.5) 0%, rgba(10, 10, 12, 0) 50%);
    pointer-events: none;
  }

  .titulo-ep {
    position: relative;
    width: 100%;
    padding-bottom: 34px;
  }

  .linea-ep {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 10px;
  }

  .linea-ep .num {
    color: var(--acento);
    white-space: nowrap;
  }

  .linea-ep .sep {
    color: var(--faint);
  }

  .nombre {
    font-size: clamp(40px, 14vw, 118px);
    color: var(--text);
  }

  .apodo {
    margin: 8px 0 0;
    font-size: 16px;
    color: var(--muted);
  }

  .coach-linea {
    margin: 14px 0 0;
    font-size: 16px;
    color: var(--text);
    text-shadow: 0 1px 8px rgba(10, 10, 12, 0.8);
  }

  .coach-linea b {
    color: var(--gold);
    font-weight: 600;
  }

  .coach-linea a {
    color: var(--gold);
    font-weight: 600;
    text-decoration-color: rgba(200, 170, 110, 0.4);
    text-underline-offset: 3px;
  }

  .coach-linea a:hover {
    color: var(--text);
  }

  .coach-rol {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sin-coach {
    color: var(--muted);
    font-style: italic;
  }

  /* ── Cuerpo ── */
  .cuerpo {
    padding-top: clamp(36px, 5vw, 56px);
  }

  /* ── El marcador: las stats del arco en grande ── */
  .marcador {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    overflow: hidden;
  }

  .stat {
    flex: 1 1 0;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 24px 16px;
  }

  .stat + .stat {
    border-left: 1px solid var(--line-soft);
  }

  .stat b {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }

  .stat-eti {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .principal {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }

  .principal > * {
    width: 100%;
  }

  .lista-titulo {
    margin: 0 0 12px;
  }

  .videos-parrilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }

  /* El arco es siempre UNA fila: n vídeos = n columnas. Los arcos de 1 y 2
     vídeos van centrados y con tope para no hincharse. */
  .videos-parrilla[data-n='2'] {
    grid-template-columns: repeat(2, minmax(0, 460px));
    justify-content: center;
  }

  .videos-parrilla[data-n='3'] {
    grid-template-columns: repeat(3, 1fr);
  }

  .videos-parrilla[data-n='4'] {
    grid-template-columns: repeat(4, 1fr);
  }

  .videos-parrilla[data-solo='si'] {
    grid-template-columns: minmax(0, 460px);
    justify-content: center;
  }

  @media (max-width: 980px) {
    .videos-parrilla[data-n='4'] {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 740px) {
    .videos-parrilla,
    .videos-parrilla[data-n='2'],
    .videos-parrilla[data-n='3'],
    .videos-parrilla[data-n='4'],
    .videos-parrilla[data-solo='si'] {
      grid-template-columns: 1fr;
    }
  }

  .video-carta {
    display: block;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .video-carta:hover {
    border-color: rgba(var(--acento-rgb), 0.65);
    transform: translateY(-2px);
  }

  .v-thumb {
    aspect-ratio: 16 / 9;
    position: relative;
  }

  .v-thumb img {
    transition: transform 0.35s ease;
  }

  .video-carta:hover .v-thumb img {
    transform: scale(1.05);
  }

  .v-hueco {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--surface-2);
  }

  .v-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 26px;
    color: var(--text);
    text-shadow: 0 2px 14px rgba(10, 10, 12, 0.9);
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .video-carta:hover .v-play,
  .video-carta:focus-visible .v-play {
    opacity: 1;
  }

  .v-pie {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 10px;
    padding: 11px 14px 13px;
    align-items: baseline;
  }

  .v-num {
    font-family: var(--display);
    font-size: 17px;
    color: var(--acento);
  }

  .v-titulo {
    margin: 0;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .v-fecha {
    grid-column: 2;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .partidas-cabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .partidas-cabecera .lista-titulo {
    margin: 0;
  }

  .partidas-resumen {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }

  .partidas-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  /* el overflow:hidden del marco redondeado recortaría el anillo de foco */
  .partidas-lista :global(summary.fila:focus-visible) {
    outline-offset: -3px;
    border-radius: 6px;
  }

  .partidas-lista :global(li + li) {
    border-top: 1px solid var(--line-soft);
  }

  .partidas-fuente {
    margin: 10px 2px 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .notas {
    margin: 0;
  }

  .prosa {
    margin-top: 14px;
    max-width: 66ch;
    color: var(--text);
  }

  .prosa :global(p) {
    margin: 0 0 14px;
    line-height: 1.7;
  }

  .prosa :global(a) {
    color: var(--gold);
  }

  .prosa :global(strong) {
    color: var(--gold);
    font-weight: 600;
  }

  .pendiente-caja {
    margin-top: 0;
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 22px 24px;
  }

  .pendiente-caja p {
    margin: 0;
    max-width: 56ch;
    font-size: 15px;
    color: var(--faint);
  }

  /* ── Build del coach (solo si el arco la documenta) ── */
  .build-coach {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 56px);
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    padding: 20px 24px;
  }

  .lista {
    margin: 8px 0 0;
    padding-left: 18px;
    font-weight: 400;
    font-size: 14.5px;
    color: var(--text);
  }

  .lista li {
    margin: 3px 0;
  }

